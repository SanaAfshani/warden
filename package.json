{
  "name": "warden",
  "private": true,
  "description": "Security controls as decorators, in two independent tracks: @sanaafshani/warden-csr-* for the browser, @sanaafshani/warden-ssr-* for Fetch-API servers.",
  "license": "MIT",
  "author": "Sana Afshani",
  "repository": { "type": "git", "url": "git+https://github.com/SanaAfshani/warden.git" },
  "homepage": "https://github.com/SanaAfshani/warden#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "keywords": ["security", "owasp", "csrf", "xss", "rate-limit", "ssrf", "decorator", "eslint-plugin"],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/ssr/*",
    "packages/csr/*",
    "packages/eslint-plugin"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.4.16",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jose": "^6.2.10",
    "jsdom": "^27.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "zod": "^4.5.4"
  },
  "packageManager": "npm@10.9.3"
}
