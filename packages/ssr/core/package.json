  "keywords": [
    "security",
    "warden",
    "server",
    "fetch-api",
    "decorator",
    "nextjs",
    "hono",
    "bun",
    "cloudflare-workers",
    "middleware",
    "owasp",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/ssr/core"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/ssr/core#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@sanaafshani/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
