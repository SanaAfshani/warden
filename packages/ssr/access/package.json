  "keywords": [
    "security",
    "warden",
    "server",
    "fetch-api",
    "decorator",
    "nextjs",
    "hono",
    "bun",
    "cloudflare-workers",
    "authorization",
    "rbac",
    "access-control",
    "permissions",
    "idor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/ssr/access"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/ssr/access#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@sanaafshani/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@sanaafshani/warden-ssr": "^0.1.1"
  },
