  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/ssr/crypto"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/ssr/crypto#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
