{
  "name": "@wardenjs/ssr-authn",
  "version": "0.2.0",
  "description": "Authentication for Fetch-API servers: signed JWT session cookies, a provider-agnostic auth decorator, password policy, lockout and scrypt hashing.",
  "keywords": [
    "wardenjs",
    "security",
    "server",
    "fetch-api",
    "decorator",
    "nextjs",
    "hono",
    "bun",
    "cloudflare-workers",
    "authentication",
    "session",
    "jwt",
    "cookie",
    "password",
    "scrypt",
    "lockout"
  ],
  "author": {
    "name": "Sana Afshani",
    "url": "https://github.com/SanaAfshani"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/ssr/authn"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/ssr/authn#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wardenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@wardenjs/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@wardenjs/ssr": "^0.2.0",
    "jose": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
