{
  "name": "@wardenjs/ssr-logging",
  "version": "0.2.0",
  "description": "Security logging for Fetch-API servers: a redacting JSON logger, a security-event sink and an error boundary that hides internals.",
  "keywords": [
    "wardenjs",
    "security",
    "server",
    "fetch-api",
    "decorator",
    "nextjs",
    "hono",
    "bun",
    "cloudflare-workers",
    "logging",
    "logger",
    "audit",
    "redaction",
    "error-handling"
  ],
  "author": {
    "name": "Sana Afshani",
    "url": "https://github.com/SanaAfshani"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/ssr/logging"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/ssr/logging#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wardenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@wardenjs/ssr": "^0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
