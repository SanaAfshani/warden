{
  "name": "@wardenjs/ssr-upload",
  "version": "0.2.0",
  "description": "File upload validation for Fetch-API servers: type detection by magic bytes, safe file names and a multipart decorator.",
  "keywords": [
    "wardenjs",
    "security",
    "server",
    "fetch-api",
    "decorator",
    "nextjs",
    "hono",
    "bun",
    "cloudflare-workers",
    "upload",
    "file-upload",
    "multipart",
    "magic-bytes",
    "file-type"
  ],
  "author": {
    "name": "Sana Afshani",
    "url": "https://github.com/SanaAfshani"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/ssr/upload"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/ssr/upload#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wardenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@wardenjs/ssr": "^0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
