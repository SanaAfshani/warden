{
  "name": "@wardenjs/csr-access",
  "version": "0.2.0",
  "description": "Permission-gated UI for the browser, with React <Can> and useCan. Display only: the server enforces.",
  "keywords": [
    "wardenjs",
    "security",
    "browser",
    "client-side",
    "decorator",
    "permissions",
    "authorization",
    "rbac",
    "react"
  ],
  "author": {
    "name": "Sana Afshani",
    "url": "https://github.com/SanaAfshani"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/csr/access"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/csr/access#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wardenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@wardenjs/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "peerDependencies": {
    "@wardenjs/csr": "^0.2.0",
    "react": ">=18.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
