{
  "name": "@wardenjs/csr-sanitize",
  "version": "0.2.0",
  "description": "XSS defence for the browser: DOMPurify HTML sanitising, Trusted Types, context-specific escaping and safe URLs, plus React <SafeHtml>.",
  "keywords": [
    "wardenjs",
    "security",
    "browser",
    "client-side",
    "decorator",
    "xss",
    "sanitize",
    "dompurify",
    "trusted-types",
    "escape-html",
    "react"
  ],
  "author": {
    "name": "Sana Afshani",
    "url": "https://github.com/SanaAfshani"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaAfshani/warden.git",
    "directory": "packages/csr/sanitize"
  },
  "homepage": "https://github.com/SanaAfshani/warden/tree/main/packages/csr/sanitize#readme",
  "bugs": "https://github.com/SanaAfshani/warden/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wardenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@wardenjs/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "peerDependencies": {
    "dompurify": "^3.4.16",
    "react": ">=18.3.0"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
